# Copy to .env and fill in real values. Never commit the real .env file
# (it's already in .gitignore) or paste live secrets into source files --
# that's exactly what happened with the DagsHub token that used to be
# hardcoded in networksecurity/components/model_trainer.py.

MONGO_DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# Shared-secret key required in the `X-API-Key` header for /train and /predict.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NETWORKSECURITY_API_KEY=<generate-a-long-random-value>

# Comma-separated list of origins allowed to call the API with credentials.
ALLOWED_ORIGINS=https://your-frontend.example.com

APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=1
